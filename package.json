{
  "name": "dsh_session_recyclebin",
  "version": "0.2.0",
  "description": "DSH 会话回收站：删除、恢复、彻底删除与定时清理。Session recycle bin for DSH with restore, permanent deletion and automatic retention.",
  "keywords": ["dsh", "dsh-plugin", "session", "recycle-bin", "trash"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./trash": {
      "default": "./lib/trash.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/shared.js",
    "lib/trash.js",
    "lib/context-types.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tools/selfcheck-title.mjs && node tools/selfcheck-client.mjs && node tools/selfcheck-client-behavior.cjs && node tools/selfcheck-trash-routes.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.2.0-rc.2"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}
